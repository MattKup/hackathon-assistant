{
  "_comment": "Правила метаданных документа по имени файла (первое совпадение). department — подразделение, stage — стадия: presale | project | full_cycle (пресейл и проект в одном документе).",
  "rules": [
    {
      "match": "Пресейлов",
      "department": "IB",
      "stage": "presale"
    },
    {
      "match": "Дирекции ИБ",
      "department": "IB",
      "stage": "project"
    },
    {
      "match": "ДБРЦТ",
      "department": "DBRCT",
      "stage": "full_cycle"
    },
    {
      "match": "Тех дирекц",
      "department": "TECH",
      "stage": "full_cycle"
    }
  ],
  "departments": {
    "IB": "Дирекция ИБ",
    "DBRCT": "ДБРЦТ",
    "TECH": "Тех дирекция"
  },
  "stages": {
    "presale": "пресейл",
    "project": "проект",
    "full_cycle": "пресейл и проект"
  },
  "departments_full": {
    "IB": "Дирекция информационной безопасности",
    "DBRCT": "Департамент бизнес-решений и цифровой трансформации",
    "TECH": "Техническая дирекция"
  },
  "department_titles": {
    "TECH": "Техническая дирекция",
    "IB": "Дирекция ИБ",
    "DBRCT": "ДБРЦТ"
  },
  "department_aliases": {
    "IB": [
      "\\bиб\\b",
      "информационн\\w* безопасн\\w*",
      "\\bуиб\\b",
      "дирекци\\w* иб"
    ],
    "DBRCT": [
      "\\bдбрцт\\b",
      "\\bдбр\\b",
      "бизнес[- ]решени\\w*",
      "цифров\\w* трансформ\\w*"
    ],
    "TECH": [
      "тех\\.?\\s*дирекц\\w*",
      "техническ\\w* дирекц\\w*",
      "\\bтд\\b",
      "техдирекц\\w*"
    ]
  },
  "_comment_aliases": "Названия и синонимы подразделений для разбора вопроса. Новое подразделение без записи здесь работает по имени из реестра (department_name).",
  "domain": "регламенты проектной деятельности компании: пресейл, заявки на расчёт, ТКП/КП, договоры с заказчиком и субподрядчиками, сметы, старт, ведение, приёмка и закрытие проектов, роли (АМ, SS, РП, архитектор и т. п.)"
}
