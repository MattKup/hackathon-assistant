{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "steps",
    "caveat",
    "missing",
    "case_covered",
    "ask",
    "ask_options"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "answer",
        "answer_with_caveat",
        "no_answer",
        "conflict"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "steps": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "who",
          "deadline",
          "ref",
          "quote"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 260
          },
          "who": {
            "type": "string",
            "maxLength": 80
          },
          "deadline": {
            "type": "string",
            "maxLength": 80
          },
          "ref": {
            "type": "string",
            "pattern": "^w[0-9]+$"
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "caveat": {
      "type": "string",
      "maxLength": 400
    },
    "missing": {
      "type": "string",
      "maxLength": 300
    },
    "case_covered": {
      "type": "boolean"
    },
    "ask": {
      "type": "string",
      "maxLength": 200
    },
    "ask_options": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  }
}
